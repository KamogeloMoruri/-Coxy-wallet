# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit the real `.env` file to version control.

# --- MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=donation_tracker
DB_USER=donation_app
DB_PASS=change_me

# --- Blockfrost (Cardano off-chain data provider) ---
# Get a free key at https://blockfrost.io  (pick "Preprod" while testing, "Mainnet" for production)
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BLOCKFROST_NETWORK=preprod
# preprod | preview | mainnet

# The address donations are collected into (used to cross-check verified transactions)
CHARITY_RECEIVE_ADDRESS=addr_test1...

# --- Anthropic (Claude) API, used by the "Ask AI" assistant ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- App ---
APP_ENV=development
# comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
